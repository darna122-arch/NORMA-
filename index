            { q: "1. Norma hukum berlaku hanya untuk anak-anak sekolah saja.", ans: false, exp: "Salah! Norma hukum berlaku mengikat bagi seluruh warga negara." },
            { q: "2. Berbohong kepada orang tua melanggar norma kesusilaan dan kesopanan.", ans: true, exp: "Benar! Berbohong melanggar kejujuran hati dan rasa hormat kepada orang tua." },
            { q: "3. Membuang sampah di sungai merupakan contoh perbuatan taat norma.", ans: false, exp: "Salah! Membuang sampah sembarangan merusak lingkungan dan melanggar norma." },
            { q: "4. Menolong teman tanpa membeda-bedakan suku dan agama adalah sikap terpuji.", ans: true, exp: "Benar! Menolong sesama mencerminkan pengamalan norma kebaikan." },
            { q: "5. Sanksi dari pelanggaran norma agama diberikan langsung oleh kepolisian.", ans: false, exp: "Salah! Sanksi norma agama berwujud dosa dari Tuhan." }
        ];

        function renderQuizzes() {
            // PG
            const pgContainer = document.getElementById('pg-questions-container');
            pgContainer.innerHTML = '';
            pgData.forEach((item, idx) => {
                const card = document.createElement('div');
                card.className = "bg-sky-50/70 p-5 rounded-2xl border border-sky-200 space-y-3";
                card.innerHTML = `
                    <p class="font-comic font-bold text-brand-dark text-base">${item.q}</p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2" id="pg-opts-${idx}">
                        ${item.opts.map((opt, oIdx) => `
                            <button onclick="checkPGAnswer(${idx}, ${oIdx})" class="p-3 bg-white hover:bg-sky-100 text-left font-comic text-sm rounded-xl border border-sky-200 btn-bounce transition">
                                ${opt}
                            </button>
                        `).join('')}
                    </div>
                    <div id="pg-fb-${idx}" class="hidden p-3 rounded-xl font-bold text-xs"></div>
                `;
                pgContainer.appendChild(card);
            });

            // Fill
            const fillContainer = document.getElementById('fill-questions-container');
            fillContainer.innerHTML = '';
            fillData.forEach((item, idx) => {
                const card = document.createElement('div');
                card.className = "bg-amber-50/70 p-5 rounded-2xl border border-amber-200 space-y-3";
                card.innerHTML = `
                    <p class="font-comic font-bold text-brand-dark text-base">${item.q}</p>
                    <div class="flex gap-2">
                        <input type="text" id="fill-input-${idx}" placeholder="Ketik jawaban..." class="p-3 rounded-xl border border-amber-300 font-comic font-bold text-brand-dark w-full max-w-xs focus:outline-none focus:ring-2 focus:ring-amber-400 text-sm">
                        <button onclick="checkFillAnswer(${idx})" class="bg-amber-500 hover:bg-amber-600 text-white font-comic font-bold px-5 py-3 rounded-xl shadow btn-bounce text-sm">
                            Jawab
                        </button>
                    </div>
                    <div id="fill-fb-${idx}" class="hidden p-3 rounded-xl font-bold text-xs"></div>
                `;
                fillContainer.appendChild(card);
            });

            // TF
            const tfContainer = document.getElementById('tf-questions-container');
            tfContainer.innerHTML = '';
            tfData.forEach((item, idx) => {
                const card = document.createElement('div');
                card.className = "bg-purple-50/70 p-5 rounded-2xl border border-purple-200 space-y-3";
                card.innerHTML = `
                    <p class="font-comic font-bold text-brand-dark text-base">${item.q}</p>
                    <div class="flex gap-3">
                        <button onclick="checkTFAnswer(${idx}, true)" class="bg-emerald-500 hover:bg-emerald-600 text-white font-comic font-bold px-6 py-2 rounded-xl shadow btn-bounce text-sm">
                            ✅ BENAR
                        </button>
                        <button onclick="checkTFAnswer(${idx}, false)" class="bg-rose-500 hover:bg-rose-600 text-white font-comic font-bold px-6 py-2 rounded-xl shadow btn-bounce text-sm">
                            ❌ SALAH
                        </button>
                    </div>
                    <div id="tf-fb-${idx}" class="hidden p-3 rounded-xl font-bold text-xs"></div>
                `;
                tfContainer.appendChild(card);
            });
        }

        function checkPGAnswer(qIdx, selected) {
            const data = pgData[qIdx];
            const fb = document.getElementById(`pg-fb-${qIdx}`);
            fb.classList.remove('hidden');

            if (selected === data.ans) {
                playSound('correct');
                fb.className = "p-3 rounded-xl font-bold text-xs bg-emerald-100 text-emerald-800 border border-emerald-300 block";
                fb.innerHTML = `🎉 Jawabanmu Benar! ${data.exp}`;
                addScore(20, 'quiz');
            } else {
                playSound('wrong');
                fb.className = "p-3 rounded-xl font-bold text-xs bg-rose-100 text-rose-800 border border-rose-300 block";
                fb.innerHTML = `❌ Kurang tepat! ${data.exp}`;
            }
        }

        function checkFillAnswer(qIdx) {
            const data = fillData[qIdx];
            const val = document.getElementById(`fill-input-${qIdx}`).value.trim().toLowerCase();
            const expected = data.ans.toLowerCase();
            const fb = document.getElementById(`fill-fb-${qIdx}`);
            fb.classList.remove('hidden');

            if (val === expected) {
                playSound('correct');
                fb.className = "p-3 rounded-xl font-bold text-xs bg-emerald-100 text-emerald-800 border border-emerald-300 block";
                fb.innerHTML = `🎉 Tepat sekali! ${data.exp}`;
                addScore(20, 'quiz');
            } else {
                playSound('wrong');
                fb.className = "p-3 rounded-xl font-bold text-xs bg-rose-100 text-rose-800 border border-rose-300 block";
                fb.innerHTML = `❌ Jawaban kamu '${val}'. Jawaban yang benar: ${data.ans}. (${data.exp})`;
            }
        }

        function checkTFAnswer(qIdx, choice) {
            const data = tfData[qIdx];
            const fb = document.getElementById(`tf-fb-${qIdx}`);
            fb.classList.remove('hidden');

            if (choice === data.ans) {
                playSound('correct');
                fb.className = "p-3 rounded-xl font-bold text-xs bg-emerald-100 text-emerald-800 border border-emerald-300 block";
                fb.innerHTML = `🎉 Tepat sekali! ${data.exp}`;
                addScore(20, 'quiz');
            } else {
                playSound('wrong');
                fb.className = "p-3 rounded-xl font-bold text-xs bg-rose-100 text-rose-800 border border-rose-300 block";
                fb.innerHTML = `❌ Masih salah! ${data.exp}`;
            }
        }

        function addScore(points, activityId) {
            gameState.score += points;
            gameState.completedActivities.add(activityId);

            // Adaptive difficulty progression
            if (gameState.score >= 150) {
                gameState.level = "Menantang";
            } else if (gameState.score >= 80) {
                gameState.level = "Sedang";
            } else {
                gameState.level = "Mudah";
            }

            document.getElementById('global-score').innerText = gameState.score;
            document.getElementById('global-level').innerText = gameState.level;

            updateGlobalProgress();
        }

        function updateGlobalProgress() {
            const total = 7;
            const current = Math.min(gameState.completedActivities.size, total);
            const percentage = Math.max(5, Math.floor((current / total) * 100));

            document.getElementById('main-progress-bar').style.width = `${percentage}%`;
        }

        function unlockBadge(badgeKey) {
            if (!gameState.badges[badgeKey]) {
                gameState.badges[badgeKey] = true;
                playSound('win');
            }
        }

        const badgeDefinitions = [
            { key: 'pemula', title: '🐣 Pejuang Cilik', desc: 'Membaca materi dasar norma' },
            { key: 'simulasi', title: '⚖️ Detektif Perilaku', desc: 'Menyelesaikan Simulasi Norma' },
            { key: 'kotak', title: '📦 Pembuka Kebaikan', desc: 'Membuka seluruh Kotak Rahasia' },
            { key: 'kilat', title: '⚡ Kilat Pejuang', desc: 'Menjawab Tantangan Cepat' },
            { key: 'master', title: '👑 Duta Norma', desc: 'Menyelesaikan Pengelompokan' }
        ];

        function updateHasilView() {
            document.getElementById('final-total-score').innerText = gameState.score;
            document.getElementById('final-level-badge').innerText = gameState.level;
            document.getElementById('final-activities-completed').innerText = `${gameState.completedActivities.size}/7`;

            const msgEl = document.getElementById('final-motivation-msg');
            if (gameState.score >= 120) {
                msgEl.innerText = "🌟 LUAR BIASA! Kamu adalah Duta Pejuang Norma Nusantara sejati!";
            } else if (gameState.score >= 60) {
                msgEl.innerText = "👍 SANGAT BAGUS! Teruslah membiasakan perilaku taat norma!";
            } else {
                msgEl.innerText = "🌱 TETAP SEMANGAT! Mari coba simulasi dan permainan sekali lagi!";
            }

            // Badges
            const container = document.getElementById('badges-container');
            container.innerHTML = '';

            badgeDefinitions.forEach(b => {
                const unlocked = gameState.badges[b.key];
                const card = document.createElement('div');
                card.className = `p-4 rounded-2xl text-center border-2 transition ${
                    unlocked 
                    ? 'bg-amber-100 border-amber-400 text-amber-900 shadow-md' 
                    : 'bg-gray-100 border-gray-300 text-gray-400 opacity-60'
                }`;
                card.innerHTML = `
                    <div class="text-3xl mb-1">${unlocked ? '🎖️' : '🔒'}</div>
                    <h4 class="font-comic font-bold text-sm">${b.title}</h4>
                    <p class="text-[11px] mt-1">${b.desc}</p>
                `;
                container.appendChild(card);
            });
        }

        function showExplanationModal(title, text) {
            document.getElementById('exp-modal-title').innerText = title;
            document.getElementById('exp-modal-body').innerHTML = text;
            document.getElementById('explanation-modal').classList.remove('hidden');
        }

        function closeExplanationModal() {
            playSound('click');
            document.getElementById('explanation-modal').classList.add('hidden');
        }

        function resetAllProgress() {
            playSound('click');
            gameState.score = 0;
            gameState.level = 'Mudah';
            gameState.completedActivities.clear();
            gameState.boxOpened = [false, false, false, false, false];
            Object.keys(gameState.badges).forEach(k => gameState.badges[k] = false);

            document.getElementById('global-score').innerText = '0';
            document.getElementById('global-level').innerText = 'Mudah';

            initDragGame();
            initMatchGame();
            renderQuizzes();
            switchTab('beranda');
        }

        window.onload = function() {
            initDragGame();
            initMatchGame();
            renderQuizzes();
            updateSimulationScenario();
        };
    </script>
</body>
</html>