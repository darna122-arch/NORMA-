            const itemObj = dragItems.find(i => i.id === id);
            const el = document.getElementById(id);

            if (!itemObj || !el) return;

            if (itemObj.type === targetType) {
                playSound('correct');
                const targetBucket = `bucket-${targetType}`;
                document.getElementById(targetBucket).appendChild(el);
                el.className = "p-2 bg-emerald-100 text-emerald-800 font-comic font-bold text-[11px] rounded-lg border border-emerald-300 text-center w-full";
                el.draggable = false;
                el.onclick = null;
